# ShrimpGuard AI - Node.js API environment template
# Copy this file to .env and fill in local values.
# Never commit the real .env file.

NODE_ENV=development
PORT=3000

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/shrimguard

# Authentication - generate a long random value; do not use this placeholder
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Python FastAPI risk analysis service
RISK_SERVICE_URL=http://localhost:8000

# Allowed web/mobile origins (comma-separated)
CORS_ORIGIN=http://localhost:5173
