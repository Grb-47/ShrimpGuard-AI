# ShrimpGuard AI - Python risk service environment template
# Copy to .env and fill in local values. Never commit the real .env.

APP_ENV=development
PORT=8000

# Optional: direct database access is not required in the foundation.
# Node.js remains the owner of stored data.
DATABASE_URL=postgresql://postgres:password@localhost:5432/shrimguard

# Google Gemini API - leave blank to keep the safe no-call fallback.
# Never commit a real key.
GEMINI_API_KEY=
# Exact Gemini model name must be confirmed before enabling AI text generation.
GEMINI_MODEL=

# Expert-validated thresholds are NOT included. Provide a JSON object to enable
# rule evaluation only after domain-expert validation. The shape is:
# WATER_QUALITY_THRESHOLDS_JSON={"ph":{"min":null,"max":null,"unit":"pH"}}
# Do not copy illustrative numbers from the internet; use validated values.
WATER_QUALITY_THRESHOLDS_JSON=

# Comma-separated allowed origins
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
